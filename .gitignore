# Rust
/target/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local environment overrides (should not be committed)
.env.local

# Runtime data
/data/cfg/rclone.conf
rclone.conf

# SQLite-Datenbank (entsteht beim ersten Start, siehe README)
# Die WAL-Begleitdateien legt SQLite im WAL-Modus zusaetzlich an.
/data/tasks.db
/data/*.db-wal
/data/*.db-shm

# Logs
*.log
/data/log/*.log

# Thumbnail-Cache (serverseitig generiert, ausserhalb des browsebaren Baums)
/data/cache/

# rsync-Daemon-Laufzeit. Enthaelt `secrets/rsyncd.secrets` — die Modul-Geheimnisse
# gekoppelter Instanzen im Klartext. Entsteht, wenn RCLONE_GUI_RSYNCD_DIR auf einen
# Pfad im Projekt zeigt (auf dem Host der uebliche Weg, weil /etc/rsyncd ohne root
# nicht beschreibbar ist). Ohne diese Zeile landen die Geheimnisse im naechsten Commit.
/data/rsyncd/

# Temporary files
*.tmp
*.temp
